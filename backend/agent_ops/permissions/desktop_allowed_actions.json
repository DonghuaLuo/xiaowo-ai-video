{
  "runtime": "xiaowo-desktop-plugin",
  "transport": "callBackend/onBackendEvent + @sdk.handler/sdk.send_event",
  "forbidden_transports": ["http", "sse", "websocket", "browser-session"],
  "allowed_backend_handlers": [
    "list_agent_sessions",
    "list_agent_conversations",
    "create_agent_conversation",
    "ensure_episode_agent_conversation",
    "get_agent_session",
    "get_agent_snapshot",
    "list_agent_skills",
    "delete_agent_session",
    "run_agent_message",
    "answer_agent_question",
    "interrupt_agent_session",
    "list_tasks",
    "cancel_task",
    "get_dashboard",
    "list_sources",
    "build_source_index",
    "list_source_index",
    "read_source_window",
    "get_episode_source_text",
    "get_source_coverage",
    "analyze_project_overview",
    "update_project_settings",
    "list_assets",
    "save_story_world_map",
    "upsert_asset",
    "delete_asset",
    "delete_all_project_assets",
    "delete_project_planning_outputs",
    "save_episode_work_chain_plan",
    "save_workflow_node_inline_edit",
    "patch_shot_prompt",
    "upsert_workflow_node",
    "delete_workflow_node",
    "resolve_generation_config",
    "validate_project_quality",
    "generate_route_video"
  ],
  "allowed_backend_events": [
    "agent_session_updated",
    "agent_session_snapshot",
    "agent_project_effect",
    "task_created",
    "task_progress",
    "task_completed",
    "task_failed",
    "project_changed"
  ],
  "agent_actions": [
    "show_progress",
    "explain_workflow",
    "analyze_overview"
  ],
  "state_contract": {
    "session_status": ["idle", "running", "completed", "error", "interrupted"],
    "task_status": ["created", "running", "completed", "failed"],
    "forced_option_lists_are_forbidden": true,
    "free_text_input_is_primary": true,
    "refresh_must_restore_running_sessions_and_tasks": true
  }
}
